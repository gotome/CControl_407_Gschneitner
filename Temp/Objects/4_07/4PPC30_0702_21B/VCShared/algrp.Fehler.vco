            <Group Name="Texts">
              <String Name="Text" Encoding="Unicode">"Napaka - PCB 24VDC"</String>
              <String Name="Text" Encoding="Unicode">"Napaka - FP kompresor modul 1"</String>
              <String Name="Text" Encoding="Unicode">"Napaka - FP kompresor modul 2"</String>
              <String Name="Text" Encoding="Unicode">"Napaka - delovanja FP kopresor modul 1"</String>
