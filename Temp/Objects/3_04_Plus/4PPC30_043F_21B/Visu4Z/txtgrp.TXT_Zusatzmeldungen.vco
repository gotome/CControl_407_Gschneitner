            <Group Name="Texts">
              <String Name="Text" Encoding="Unicode">"Napaka naprave! – Glejte stran z alarmi – zagon ni mogoč"</String>
              <String Name="Text" Encoding="Unicode">"Preizkus iz./vh. ni končan – zagon ni mogoč"</String>
              <String Name="Text" Encoding="Unicode">"Mirovanje"</String>
              <String Name="Text" Encoding="Unicode">"Čakanje na izklop razvlaževalnika ..."</String>
              <String Name="Text" Encoding="Unicode">"Čakanje na pripravljenost zasilnega generatorja ..."</String>
              <String Name="Text" Encoding="Unicode">"Čakanje na mirovanje kotla na vroči zrak ..."</String>
              <String Name="Text" Encoding="Unicode">"Čakanje na mirovanje kotla na polena ..."</String>
              <String Name="Text" Encoding="Unicode">"Zakasnitev vklopa ventilatorja 2"</String>
              <String Name="Text" Encoding="Unicode">"Zakasnitev vklopa ventilatorja 1"</String>
              <String Name="Text" Encoding="Unicode">"Izklop el. tarife je aktiven"</String>
              <String Name="Text" Encoding="Unicode">"Omejitev toka je aktivna"</String>
              <String Name="Text" Encoding="Unicode">"Preklapljanje loput ..."</String>
              <String Name="Text" Encoding="Unicode">"Delovanje s svežim zrakom"</String>
              <String Name="Text" Encoding="Unicode">"Delovanje z zrakom s strehe"</String>
              <String Name="Text" Encoding="Unicode">"Delovanje s cirkulacijskim zrakom"</String>
              <String Name="Text" Encoding="Unicode">"Čakanje na zahtevo komore ..."</String>
              <String Name="Text" Encoding="Unicode">"Napaka naprave! Glejte stran z alarmi"</String>
              <String Name="Text" Encoding="Unicode">"Delovanje s svežim zrakom – enote za sušenje IZKLOP (čas priprave izklopa el. tarife)"</String>
              <String Name="Text" Encoding="Unicode">"Delovanje z zrakom s strehe – enote za sušenje IZKLOP (čas priprave izklopa el. tarife)"</String>
              <String Name="Text" Encoding="Unicode">"Delovanje s cirkulacijskim zrakom – enote za sušenje IZKLOP (čas priprave el. tarife)"</String>
              <String Name="Text" Encoding="Unicode">""</String>
              <String Name="Text" Encoding="Unicode">""</String>
              <String Name="Text" Encoding="Unicode">""</String>
              <String Name="Text" Encoding="Unicode">""</String>
